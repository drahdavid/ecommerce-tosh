# ─── Core ────────────────────────────────────────────────────────────────
# Local: docker compose up -d  →  postgres://postgres:postgres@127.0.0.1:5433/tosh
# Producción: connection string POOLED de Neon (…-pooler…/neondb?sslmode=require)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/tosh
DATABASE_POOL_MAX=5
PAYLOAD_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
# URL pública del sitio, sin barra final. Mercado Pago necesita https para webhooks y auto_return.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Vercel lo envía como "Authorization: Bearer <CRON_SECRET>" en los cron jobs.
CRON_SECRET=cambiar-por-otro-secreto
ORDER_NUMBER_PREFIX=TOSH

# ─── Imágenes: Cloudflare R2 (si se omite, se guardan en disco local) ─────
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Dominio público del bucket (r2.dev o propio), sin barra final
NEXT_PUBLIC_MEDIA_URL=

# ─── Mercado Pago (Tus integraciones → Credenciales) ─────────────────────
MP_ACCESS_TOKEN=
# Tus integraciones → Webhooks → "Clave secreta". La URL de notificación se configura ahí mismo:
# producción https://TU-DOMINIO/api/webhooks/mercadopago · desarrollo: URL de un túnel (cloudflared) en "URL para prueba".
MP_WEBHOOK_SECRET=

# ─── Email: Resend (si se omite, los emails se imprimen en consola) ───────
RESEND_API_KEY=
EMAIL_FROM=pedidos@tudominio.com.ar
EMAIL_FROM_NAME=Tosh

# ─── Cotización ──────────────────────────────────────────────────────────
DOLARAPI_URL=https://dolarapi.com/v1/dolares/oficial

# ─── Envíos ──────────────────────────────────────────────────────────────
ZIPNOVA_API_KEY=
ZIPNOVA_API_SECRET=
# Próximamente: CORREOAR_USER / CORREOAR_PASSWORD / CORREOAR_ENV, ANDREANI_*

# ─── Analytics / monitoreo (opcional) ────────────────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
